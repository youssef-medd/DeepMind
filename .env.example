# Copy to .env and fill in real values. Do not commit .env.
# Phase 2 — LLM routing + synthesis
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model selection (choose one provider above)
LLM_PROVIDER=anthropic          # openai | anthropic
LLM_MODEL=claude-sonnet-4-6     # e.g. gpt-4o-mini, claude-sonnet-4-6

# Generation params (used by orchestratorPlan + orchestratorSynthesize)
LLM_TEMPERATURE=0.2             # 0.0–1.0 — lower = more deterministic routing
LLM_MAX_TOKENS=1024             # cap for synthesis responses
LLM_TIMEOUT_MS=30000            # per-call timeout in ms — abort slow providers
LLM_RETRY_ATTEMPTS=2            # retry count on transient provider errors (5xx, timeouts)
LLM_RETRY_BACKOFF_MS=500        # base delay between retries — doubled each attempt (exponential)
LLM_RETRY_JITTER_MS=100         # random jitter added to backoff — prevents thundering herd on retry
LLM_LOG_LEVEL=info              # trace | debug | info | warn | error — verbosity of provider call logs
LLM_STREAM=false                # stream tokens as they arrive vs wait for full response
LLM_BASE_URL=                   # override provider endpoint — leave blank for default (use for proxy/self-hosted)
LLM_TOP_P=1.0                   # nucleus sampling — cap token pool by cumulative prob (1.0 = disabled)
LLM_SEED=                       # deterministic sampling seed — leave blank for random (provider must support it)
LLM_FREQUENCY_PENALTY=0.0       # -2.0–2.0 — penalize repeated tokens by frequency (0.0 = disabled)
LLM_PRESENCE_PENALTY=0.0        # -2.0–2.0 — penalize tokens already present (encourages new topics, 0.0 = disabled)
LLM_STOP=                       # comma-separated stop sequences — halt generation when matched (leave blank for none)
LLM_USER_AGENT=                 # custom User-Agent header sent to provider — leave blank for SDK default
LLM_ORG_ID=                     # provider organization/workspace ID — routes billing/quota (leave blank for account default)
LLM_PROJECT_ID=                 # provider project ID — scopes usage/keys to project (leave blank for account default)
